import { LineEdit, ScrollView } from "std-widgets.slint";

export struct AnimeCardData {
    id: string,
    title: string,
    details: string,
    poster: image,
}

export struct EpisodeRowData {
    id: string,
    title: string,
    details: string,
}

export struct MangaPageData {
    number: string,
    page: image,
}

component AnimeTile inherits Rectangle {
    in property <AnimeCardData> anime;
    callback chosen(string, string, image);

    height: 248px;
    background: #161b22;
    border-radius: 9px;
    clip: true;
    border-width: 1px;
    border-color: #282e38;

    VerticalLayout {
        spacing: 0px;
        Image {
            width: parent.width;
            height: 188px;
            source: root.anime.poster;
            image-fit: cover;
        }
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            Text {
                text: root.anime.title;
                color: #e6edf3;
                font-size: 13px;
                font-weight: 700;
                wrap: word-wrap;
                overflow: elide;
                vertical-stretch: 1;
            }
            Text {
                text: root.anime.details;
                color: #8b949e;
                font-size: 10px;
                overflow: elide;
            }
        }
    }

    TouchArea {
        clicked => { root.chosen(root.anime.id, root.anime.title, root.anime.poster); }
    }
}

component EpisodeTile inherits Rectangle {
    in property <EpisodeRowData> episode;
    callback chosen(string);

    height: 64px;
    background: #161b22;
    border-radius: 8px;
    border-width: 1px;
    border-color: #282e38;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: center;
        Rectangle {
            width: 34px;
            height: 34px;
            background: #292340;
            border-radius: 7px;
            Text {
                text: "▶";
                color: #b7a7ff;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            spacing: 3px;
            vertical-stretch: 1;
            Text {
                text: root.episode.title;
                color: #e6edf3;
                font-size: 13px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.episode.details;
                color: #8b949e;
                font-size: 10px;
                overflow: elide;
            }
        }
        Text {
            text: "›";
            color: #8b949e;
            font-size: 23px;
        }
    }

    TouchArea {
        clicked => { root.chosen(root.episode.id); }
    }
}

export component MainWindow inherits Window {
    title: "Zenime";
    width: 400px;
    height: 850px;
    background: #0d1117;

    in-out property <[AnimeCardData]> anime-cards: [];
    in-out property <[EpisodeRowData]> episodes: [];
    in-out property <[MangaPageData]> manga-pages: [];
    in-out property <[AnimeCardData]> saved-cards: [];
    in-out property <[AnimeCardData]> history-cards: [];
    in-out property <string> search-kind: "ANIME";
    in-out property <string> anilist-username: "Not connected";
    in-out property <string> active-page: "home";
    in-out property <string> active-category: "trending";
    in-out property <string> status: "Starting Zenime…";
    in-out property <string> search-query: "";
    in-out property <string> api-url: "";
    in-out property <string> selected-title: "";
    in-out property <string> selected-id: "";
    in-out property <string> selected-description: "";
    in-out property <image> selected-poster;
    in-out property <string> selected-meta: "";

    callback category-selected(string);
    callback search-requested(string);
    callback anime-selected(string, string, image);
    callback episode-selected(string);
    callback navigate(string);
    callback save-selected();
    callback save-api-url(string);
    callback refresh-requested();
    callback history-action(string);
    callback manga-action(string);
    callback profile-action(string);
    callback open-link(string);

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 58px;
            background: #0d1117;
            border-width: 0px;
            HorizontalLayout {
                padding-left: 17px;
                padding-right: 15px;
                spacing: 9px;
                alignment: center;
                Text {
                    text: "zenime";
                    color: #f0f2f5;
                    font-size: 28px;
                    font-weight: 800;
                    letter-spacing: -1px;
                }
                Rectangle {
                    width: 6px;
                    height: 6px;
                    background: #a78bfa;
                    border-radius: 3px;
                }
                Text {
                    text: "NATIVE";
                    color: #a78bfa;
                    font-size: 9px;
                    font-weight: 800;
                    letter-spacing: 1px;
                }
                Rectangle { horizontal-stretch: 1; }
                TouchArea {
                    width: 36px;
                    height: 36px;
                    clicked => { root.navigate("settings"); }
                    Text {
                        text: "⚙";
                        color: #c9d1d9;
                        font-size: 19px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { height: 1px; background: #21262d; }

        if root.active-page == "home" : ScrollView {
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 14px;
                padding-bottom: 18px;
                spacing: 14px;

                Rectangle {
                    height: 132px;
                    background: #171626;
                    border-radius: 12px;
                    clip: true;
                    Rectangle {
                        x: parent.width - 92px;
                        y: -35px;
                        width: 165px;
                        height: 165px;
                        background: #292347;
                        border-radius: 82px;
                        opacity: 0.8;
                    }
                    Rectangle {
                        x: parent.width - 52px;
                        y: 50px;
                        width: 90px;
                        height: 90px;
                        background: #44366d;
                        border-radius: 45px;
                        opacity: 0.65;
                    }
                    VerticalLayout {
                        padding: 15px;
                        spacing: 7px;
                        Text {
                            text: "YOUR NEXT FAVORITE";
                            color: #b7a7ff;
                            font-size: 10px;
                            font-weight: 800;
                            letter-spacing: 1px;
                        }
                        Text {
                            text: "Find your anime.";
                            color: #ffffff;
                            font-size: 24px;
                            font-weight: 800;
                        }
                        Text {
                            text: "Explore stories worth staying up for.";
                            color: #c6c0df;
                            font-size: 11px;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        horizontal-stretch: 1;
                        height: 42px;
                        text <=> root.search-query;
                        placeholder-text: "Search anime…";
                        accepted => { root.search-requested(root.search-query); }
                    }
                    Rectangle {
                        width: 47px;
                        height: 42px;
                        background: #8b79d9;
                        border-radius: 7px;
                        Text {
                            text: "⌕";
                            color: #ffffff;
                            font-size: 24px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.search-requested(root.search-query); }
                        }
                    }
                }

                Text {
                    text: "Discover";
                    color: #f0f2f5;
                    font-size: 21px;
                    font-weight: 800;
                }

                HorizontalLayout {
                    spacing: 6px;
                    CategoryChip { label: "Trending"; active: root.active-category == "trending"; chosen => { root.active-category = "trending"; root.category-selected("trending"); } }
                    CategoryChip { label: "Popular"; active: root.active-category == "popular"; chosen => { root.active-category = "popular"; root.category-selected("popular"); } }
                    CategoryChip { label: "Top rated"; active: root.active-category == "top-rated"; chosen => { root.active-category = "top-rated"; root.category-selected("top-rated"); } }
                    CategoryChip { label: "Latest"; active: root.active-category == "latest"; chosen => { root.active-category = "latest"; root.category-selected("latest"); } }
                }

                Text {
                    text: root.status;
                    color: #9da7b3;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                GridLayout {
                    spacing: 11px;
                    for anime[index] in root.anime-cards: AnimeTile {
                        col: index.mod(2);
                        row: index / 2;
                        anime: anime;
                        chosen(id, title, poster) => { root.anime-selected(id, title, poster); }
                    }
                }
            }
        }

        if root.active-page == "search" : ScrollView {
            VerticalLayout {
                padding: 14px;
                spacing: 13px;
                Text {
                    text: "Search anime";
                    color: #f0f2f5;
                    font-size: 23px;
                    font-weight: 800;
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        horizontal-stretch: 1;
                        height: 42px;
                        text <=> root.search-query;
                        placeholder-text: "Title, genre, or keyword";
                        accepted => { root.search-requested(root.search-query); }
                    }
                    Rectangle {
                        width: 48px;
                        height: 42px;
                        background: #8b79d9;
                        border-radius: 7px;
                        Text {
                            text: "⌕";
                            color: #ffffff;
                            font-size: 23px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.search-requested(root.search-query); }
                        }
                    }
                }
                Text {
                    text: root.status;
                    color: #9da7b3;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                GridLayout {
                    spacing: 11px;
                    for anime[index] in root.anime-cards: AnimeTile {
                        col: index.mod(2);
                        row: index / 2;
                        anime: anime;
                        chosen(id, title, poster) => { root.anime-selected(id, title, poster); }
                    }
                }
            }
        }

        if root.active-page == "detail" : ScrollView {
            VerticalLayout {
                padding: 14px;
                spacing: 12px;
                TouchArea {
                    height: 27px;
                    clicked => { root.navigate("home"); }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "‹"; color: #b7a7ff; font-size: 23px; }
                        Text { text: "Back to discover"; color: #b7a7ff; font-size: 12px; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    height: 220px;
                    background: #161b22;
                    border-radius: 10px;
                    clip: true;
                    Image {
                        source: root.selected-poster;
                        image-fit: cover;
                        width: parent.width;
                        height: parent.height;
                    }
                }
                Text {
                    text: root.selected-title;
                    color: #f0f2f5;
                    font-size: 23px;
                    font-weight: 800;
                    wrap: word-wrap;
                }
                Text {
                    text: root.selected-meta;
                    color: #b7a7ff;
                    font-size: 11px;
                }
                Text {
                    text: root.selected-description;
                    color: #aeb8c4;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 42px;
                    background: #292340;
                    border-radius: 8px;
                    Text {
                        text: "♡   Save to library";
                        color: #d7ceff;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.save-selected(); } }
                }
                Text {
                    text: "Episodes";
                    color: #f0f2f5;
                    font-size: 19px;
                    font-weight: 800;
                }
                Text {
                    text: root.status;
                    color: #9da7b3;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                for episode in root.episodes: EpisodeTile {
                    episode: episode;
                    chosen(id) => { root.episode-selected(id); }
                }
            }
        }

        if root.active-page == "saved" : ScrollView {
            VerticalLayout {
                padding: 14px;
                spacing: 13px;
                Text {
                    text: "Your library";
                    color: #f0f2f5;
                    font-size: 23px;
                    font-weight: 800;
                }
                Text {
                    text: root.status;
                    color: #9da7b3;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                GridLayout {
                    spacing: 11px;
                    for anime[index] in root.saved-cards: AnimeTile {
                        col: index.mod(2);
                        row: index / 2;
                        anime: anime;
                        chosen(id, title, poster) => { root.anime-selected(id, title, poster); }
                    }
                }
            }
        }

        if root.active-page == "reader" : ScrollView {
            VerticalLayout {
                padding: 10px; spacing: 10px;
                HorizontalLayout {
                    height: 38px; spacing: 8px;
                    Rectangle {
                        width: 70px; background: #292340; border-radius: 7px;
                        Text { text: "‹ Back"; color: #d7ceff; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.navigate("detail"); } }
                    }
                    Text { text: root.selected-title; color: #f0f2f5; font-size: 14px; font-weight: 800; vertical-alignment: center; overflow: elide; }
                }
                Text { text: root.status; color: #9da7b3; font-size: 11px; wrap: word-wrap; }
                for page in root.manga-pages: VerticalLayout {
                    spacing: 3px;
                    Text { text: page.number; color: #b7a7ff; font-size: 10px; horizontal-alignment: center; }
                    Image { source: page.page; image-fit: contain; width: parent.width; height: 520px; }
                }
            }
        }

        if root.active-page == "history" : ScrollView {
            VerticalLayout {
                padding: 14px;
                spacing: 13px;
                Text { text: "Watch history"; color: #f0f2f5; font-size: 23px; font-weight: 800; }
                Text { text: "Resume recent episodes and manage your local viewing history."; color: #9da7b3; font-size: 11px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 38px; background: #292340; border-radius: 7px; horizontal-stretch: 1;
                        Text { text: "Refresh"; color: #d7ceff; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.history-action("refresh"); } }
                    }
                    Rectangle {
                        height: 38px; background: #3b2027; border-radius: 7px; horizontal-stretch: 1;
                        Text { text: "Clear history"; color: #ffb4bd; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.history-action("clear"); } }
                    }
                }
                Text { text: root.status; color: #9da7b3; font-size: 11px; wrap: word-wrap; }
                GridLayout {
                    spacing: 11px;
                    for anime[index] in root.history-cards: AnimeTile {
                        col: index.mod(2); row: index / 2; anime: anime;
                        chosen(id, title, poster) => { root.anime-selected(id, title, poster); }
                    }
                }
            }
        }

        if root.active-page == "manga" : ScrollView {
            VerticalLayout {
                padding: 14px;
                spacing: 13px;
                Text { text: "Manga"; color: #f0f2f5; font-size: 23px; font-weight: 800; }
                Text { text: "Browse manga using the catalog metadata backend. Chapter-reader support depends on the configured provider."; color: #9da7b3; font-size: 11px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        horizontal-stretch: 1; height: 42px;
                        text <=> root.search-query;
                        placeholder-text: "Search manga…";
                        accepted => { root.manga-action(root.search-query); }
                    }
                    Rectangle {
                        width: 48px; height: 42px; background: #8b79d9; border-radius: 7px;
                        Text { text: "⌕"; color: #ffffff; font-size: 23px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.manga-action(root.search-query); } }
                    }
                }
                Text { text: root.status; color: #9da7b3; font-size: 11px; wrap: word-wrap; }
                GridLayout {
                    spacing: 11px;
                    for anime[index] in root.anime-cards: AnimeTile {
                        col: index.mod(2); row: index / 2; anime: anime;
                        chosen(id, title, poster) => { root.anime-selected(id, title, poster); }
                    }
                }
            }
        }

        if root.active-page == "profile" : ScrollView {
            VerticalLayout {
                padding: 16px;
                spacing: 13px;
                Rectangle {
                    height: 105px; background: #171626; border-radius: 12px;
                    VerticalLayout {
                        padding: 14px; spacing: 7px;
                        Text { text: "Your Zenime profile"; color: #ffffff; font-size: 20px; font-weight: 800; }
                        Text { text: root.anilist-username; color: #b7a7ff; font-size: 12px; }
                        Text { text: "Connect AniList to sync lists, scores, progress, and favourites."; color: #c6c0df; font-size: 11px; wrap: word-wrap; }
                    }
                }
                Rectangle {
                    height: 43px; background: #8b79d9; border-radius: 8px;
                    Text { text: "Connect AniList"; color: #ffffff; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.profile-action("login"); } }
                }
                Rectangle {
                    height: 42px; background: #161b22; border-radius: 8px;
                    Text { text: "Refresh account and list stats"; color: #e6edf3; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.profile-action("refresh"); } }
                }
                Rectangle {
                    height: 42px; background: #161b22; border-radius: 8px;
                    Text { text: "Open AniList website"; color: #e6edf3; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.open-link("https://anilist.co/"); } }
                }
                Text { text: "Account support requires a registered AniList OAuth client ID and a secure callback configuration. Never put a client secret inside the APK."; color: #8b949e; font-size: 10px; wrap: word-wrap; }
                Text { text: root.status; color: #9da7b3; font-size: 11px; wrap: word-wrap; }
            }
        }

        if root.active-page == "about" : ScrollView {
            VerticalLayout {
                padding: 16px; spacing: 13px;
                Text { text: "About Zenime"; color: #f0f2f5; font-size: 23px; font-weight: 800; }
                Text { text: "Zenime is an anime discovery and media-tracking project derived from Miruro. This native edition uses Rust for app logic and Slint for its compiled interface."; color: #aeb8c4; font-size: 12px; wrap: word-wrap; }
                Text { text: "Native app features"; color: #e6edf3; font-size: 16px; font-weight: 800; }
                Text { text: "Discovery and search • metadata and episodes • native video playback • saved library • viewing history • manga catalog and reading integration • AniList account integration • profile and statistics • settings and preferences."; color: #9da7b3; font-size: 12px; wrap: word-wrap; }
                Rectangle { height: 42px; background: #161b22; border-radius: 8px;
                    Text { text: "Open Zenime website"; color: #e6edf3; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.open-link("https://github.com/Brentph505/Zenime"); } }
                }
                Text { text: "Keep the upstream attribution and non-commercial license when redistributing this derivative."; color: #8b949e; font-size: 10px; wrap: word-wrap; }
            }
        }

        if root.active-page == "settings" : ScrollView {
            VerticalLayout {
                padding: 16px;
                spacing: 13px;
                Text {
                    text: "Settings";
                    color: #f0f2f5;
                    font-size: 23px;
                    font-weight: 800;
                }
                Text {
                    text: "API endpoint";
                    color: #e6edf3;
                    font-size: 13px;
                    font-weight: 700;
                }
                Text {
                    text: "Use a compatible Zenime / Miruro metadata backend. The app connects directly over HTTPS.";
                    color: #9da7b3;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                LineEdit {
                    width: parent.width;
                    height: 44px;
                    text <=> root.api-url;
                    placeholder-text: "https://example.com/";
                }
                Rectangle {
                    height: 43px;
                    background: #8b79d9;
                    border-radius: 8px;
                    Text {
                        text: "Save endpoint and refresh";
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.save-api-url(root.api-url); } }
                }
                Rectangle { height: 1px; background: #30363d; }
                Text {
                    text: "About Zenime";
                    color: #e6edf3;
                    font-size: 16px;
                    font-weight: 800;
                }
                Text {
                    text: "A Rust-powered native Android client. The interface is compiled native code and the video screen uses Android Media3; this app does not embed a website or WebView.";
                    color: #9da7b3;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Attribution: Zenime is a non-commercial fork derived from Miruro no Kuon. Please retain the root repository's attribution and non-commercial license when redistributing.";
                    color: #8b949e;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.status;
                    color: #9da7b3;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 38px;
                    background: #161b22;
                    border-radius: 8px;
                    Text {
                        text: "Refresh catalog";
                        color: #e6edf3;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.refresh-requested(); } }
                }
            }
        }

        Rectangle {
            height: 67px;
            background: #0d1117;
            border-width: 1px;
            border-color: #21262d;
            HorizontalLayout {
                spacing: 0px;
                NavItem { label: "HOME"; glyph: "⌂"; chosen => { root.navigate("home"); } }
                NavItem { label: "SEARCH"; glyph: "⌕"; chosen => { root.navigate("search"); } }
                NavItem { label: "SAVED"; glyph: "♡"; chosen => { root.navigate("saved"); } }
                NavItem { label: "HISTORY"; glyph: "◷"; chosen => { root.navigate("history"); } }
                NavItem { label: "MANGA"; glyph: "▤"; chosen => { root.navigate("manga"); } }
                NavItem { label: "PROFILE"; glyph: "●"; chosen => { root.navigate("profile"); } }
                NavItem { label: "SETTINGS"; glyph: "⚙"; chosen => { root.navigate("settings"); } }
            }
        }
    }
}

component CategoryChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback chosen();

    background: active ? #403568 : #161b22;
    border-radius: 7px;
    border-width: 1px;
    border-color: active ? #8b79d9 : #30363d;
    height: 31px;
    horizontal-stretch: 1;
    Text {
        text: root.label;
        color: root.active ? #ffffff : #aeb8c4;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.chosen(); } }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    callback chosen();

    horizontal-stretch: 1;
    background: #0d1117;
    VerticalLayout {
        spacing: 2px;
        alignment: center;
        Text {
            text: root.glyph;
            color: #b7a7ff;
            font-size: 20px;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            color: #8b949e;
            font-size: 9px;
            font-weight: 800;
            horizontal-alignment: center;
        }
    }
    TouchArea { clicked => { root.chosen(); } }
}
